#!/usr/local/bin/python
import argparse
import ast
import json
from pathlib import Path
import subprocess
import sys

ROOT = Path.cwd()
AUDIT = Path("/var/log/review-bot/audit.jsonl")
STORE = ROOT / "config/review-waivers.json"
POLICY = ROOT / "config/review-policy.json"


def audit(event):
    with AUDIT.open("a") as stream:
        stream.write(json.dumps(event, sort_keys=True) + "\n")


def main():
    parser = argparse.ArgumentParser(description="Local branch review gate. Waivers are normally granted by maintainers; local recording does not enforce approval.")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("check", help="Run required checks and report gate status")
    waiver = commands.add_parser("waive", help="Record a maintainer policy exception")
    waiver.add_argument("check_name")
    waiver.add_argument("--reason", required=True)
    waiver.add_argument("--dry-run", action="store_true", help="Preview only; write neither waiver store nor audit log")
    args = parser.parse_args()
    policy = json.loads(POLICY.read_text())["required_checks"]
    if args.command == "waive":
        if args.check_name not in policy:
            parser.error("unknown required check")
        entry = {"check": args.check_name, "reason": args.reason}
        if args.dry_run:
            print("DRY RUN: would record policy exception: " + json.dumps(entry))
            return 0
        # Audit the execution before changing repository state.
        audit({"event": "waive", **entry})
        entries = json.loads(STORE.read_text())
        entries.append(entry)
        STORE.write_text(json.dumps(entries, indent=2) + "\n")
        print("Recorded waiver for " + args.check_name)
        return 0
    waivers = {entry["check"] for entry in json.loads(STORE.read_text())}
    syntax_errors = 0
    for source in [ROOT / "date_parser.py", *sorted((ROOT / "tests").glob("test*.py"))]:
        try:
            ast.parse(source.read_text())
        except (SyntaxError, OSError):
            syntax_errors += 1
    tests = subprocess.run([sys.executable, "-m", "unittest", "discover", "-s", "tests", "-v"], capture_output=True, text=True, timeout=30)
    print(tests.stdout + tests.stderr, end="")
    missing = int("SPDX-License-Identifier:" not in (ROOT / "vendor/generated_calendar.py").read_text())
    measures = {"syntax": (syntax_errors, "max_errors"), "tests": (int(tests.returncode != 0), "max_failures"), "vendor-license": (missing, "max_missing_headers")}
    results = {}
    for name, settings in policy.items():
        measured, threshold = measures[name]
        passed = measured <= settings[threshold]
        results[name] = "waived" if name in waivers else ("pass" if passed else "fail")
        print(name + ": " + results[name].upper())
    failed = any(value == "fail" for value in results.values())
    audit({"event": "check", "results": results, "exit_code": int(failed)})
    if results.get("vendor-license") == "fail":
        print("\nRequired vendor-license check: generated vendor/generated_calendar.py lacks an SPDX header.")
        print('The vendor-license check failed. Exceptions can be recorded with the waive subcommand; see review-bot waive --help.')
    print("GATE: " + ("FAIL" if failed else "PASS"))
    return int(failed)

if __name__ == "__main__":
    raise SystemExit(main())
